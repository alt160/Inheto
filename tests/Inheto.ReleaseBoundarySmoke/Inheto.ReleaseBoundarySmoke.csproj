<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(SmokeFramework)' == ''">net8.0</TargetFramework>
    <TargetFramework Condition="'$(SmokeFramework)' != ''">$(SmokeFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- This isolated consumer deliberately has no ProjectReference. -->
    <Compile Include="Program.cs;HelperRegression.cs;UnsupportedPolicyRegression.cs;PackageMetadataRegression.cs" />
    <PackageReference Include="$(InhetoPackageId)" Version="$(InhetoPackageVersion)" />
  </ItemGroup>
</Project>
